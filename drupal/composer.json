{
    "name": "uvalib/mandala",
    "description": "Mandala Digital Library — University of Virginia Library",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "drupal/kaltura_media",
                "version": "1.0.4",
                "type": "drupal-module",
                "dist": {
                    "type": "tar",
                    "url": "https://ftp.drupal.org/files/projects/kaltura_media-1.0.4.tar.gz"
                },
                "require": {
                    "drupal/core": "^8 || ^9 || ^10 || ^11"
                }
            }
        },
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "php": ">=8.3",
        "composer/installers": "^2.0",
        "cweagans/composer-patches": "^2.0",
        "drupal/admin_toolbar": "^3.5",
        "drupal/better_exposed_filters": "^7.1",
        "drupal/bootstrap5": "^4.0",
        "drupal/core-composer-scaffold": "^11",
        "drupal/core-project-message": "^11",
        "drupal/core-recommended": "^11",
        "drupal/devel": "^5.0",
        "drupal/entity_reference_revisions": "^1.12",
        "drupal/facets": "^3.0",
        "drupal/footnotes": "^4.0",
        "drupal/group": "^3.3",
        "drupal/kaltura_media": "1.0.4",
        "drupal/migrate_plus": "^6.0",
        "drupal/migrate_tools": "^6.1",
        "drupal/paragraphs": "^1.18",
        "drupal/search_api": "^1.34",
        "drupal/search_api_solr": "^4.3",
        "drupal/simple_oauth": "^6.1",
        "drupal/simplesamlphp_auth": "^4.1",
        "drush/drush": "^13",
        "predis/predis": "^3.3"
    },
    "require-dev": {
        "drupal/core-dev": "^11",
        "drupal/upgrade_status": "^4.0"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3"
        },
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "simplesamlphp/composer-module-installer": true,
            "simplesamlphp/composer-xmlprovider-installer": true,
            "tbachert/spi": true,
            "symfony/runtime": true
        }
    },
    "extra": {
        "composer-exit-on-patch-failure": true,
        "patches": {
            "drupal/kaltura_media": {
                "Declare Drupal 11 compatibility (drupal.org has not tagged a D11 release; module code itself is D11-clean per upgrade_status)": "patches/kaltura_media-d11-core-version.patch",
                "Fix deprecated FileSystemInterface::EXISTS_REPLACE and a pre-existing missing FileException import (both found via upgrade_status:analyze, Spike 7)": "patches/kaltura_media-file-exists-deprecation-and-missing-import.patch"
            }
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[web-root]/robots.txt": false
            }
        },
        "installer-paths": {
            "web/core": ["type:drupal-core"],
            "web/libraries/{$name}": ["type:drupal-library"],
            "web/modules/contrib/{$name}": ["type:drupal-module"],
            "web/profiles/contrib/{$name}": ["type:drupal-profile"],
            "web/themes/contrib/{$name}": ["type:drupal-theme"],
            "drush/Commands/contrib/{$name}": ["type:drupal-drush"],
            "web/modules/custom/{$name}": ["type:drupal-custom-module"],
            "web/themes/custom/{$name}": ["type:drupal-custom-theme"]
        },
        "drupal-core-project-message": {
            "include-keys": ["homepage", "support"],
            "post-create-project-cmd-prompt": false
        }
    }
}
