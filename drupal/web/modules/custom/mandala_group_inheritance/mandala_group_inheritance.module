<?php

/**
 * @file
 * Visibility and membership inheritance for collection/subcollection groups.
 *
 * Implements the five hooks required by ADR 011 (Option D):
 *   1. hook_entity_access     — enforce collection visibility on group content
 *   2. hook_group_presave     — copy parent visibility when subcollection is created
 *   3. hook_group_update      — propagate collection visibility change to subcollections
 *   4. hook_group_relationship_insert — cascade new members and backfill on subcollection create
 *   5. hook_group_relationship_delete — cascade member removal (with sub-only retention guard)
 */

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Database\Query\AlterableInterface;
use Drupal\Core\Database\Query\SelectInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\Session\AccountInterface;
use Drupal\group\Entity\GroupInterface;
use Drupal\group\Entity\GroupRelationshipInterface;
use Drupal\mandala_group_inheritance\Access\CollectionVisibility;

// ---------------------------------------------------------------------------
// Membership metadata
// ---------------------------------------------------------------------------

/**
 * Implements hook_entity_base_field_info().
 *
 * Adds a boolean `mandala_inherited` flag to group relationships so the
 * membership-cascade logic can distinguish an inherited (cascaded-from-parent)
 * subcollection membership from one added directly to the subcollection.
 *
 * Group 3.x's group_relationship entity has no generic `data` field, so the
 * flag needs its own typed field — an earlier version stored it in a
 * non-existent `data` field, which silently dropped it on write and threw on
 * read. See docs/deferred/group-relationship-delete-broken-no-data-field.md.
 */
function mandala_group_inheritance_entity_base_field_info(EntityTypeInterface $entity_type) {
  $fields = [];
  if ($entity_type->id() === 'group_relationship') {
    $fields['mandala_inherited'] = BaseFieldDefinition::create('boolean')
      ->setLabel(t('Inherited membership'))
      ->setDescription(t('TRUE if this membership was cascaded from a parent collection rather than added directly.'))
      ->setDefaultValue(FALSE)
      ->setInternal(TRUE);
  }
  return $fields;
}

// ---------------------------------------------------------------------------
// Access control
// ---------------------------------------------------------------------------

/**
 * Implements hook_entity_access().
 *
 * Enforces collection visibility on group entities and on the nodes inside
 * them. The type-level outsider/anonymous roles grant view by default; this
 * hook restricts that grant so per-collection visibility is actually enforced.
 */
function mandala_group_inheritance_entity_access(EntityInterface $entity, $operation, AccountInterface $account) {
  if ($operation !== 'view') {
    return AccessResult::neutral();
  }

  // Restrict access to private groups themselves.
  if ($entity->getEntityTypeId() === 'group' && in_array($entity->bundle(), CollectionVisibility::GROUP_BUNDLES)) {
    return _mandala_group_inheritance_group_access($entity, $account);
  }

  // Restrict access to group content. Any bundle with a group_node plugin is
  // in scope, discovered rather than listed: this check was hardcoded to
  // `shanti_image` until 2026-09-25, so audio/video never reached it at all and
  // 2,027 published AV nodes D7 restricted were viewable by anyone. That was
  // the fourth bug of this exact shape (PR #201's group role grants, PR #199's
  // groupKmassetUid(), SiblingCarouselService::getCollectionMemberNids()), so
  // Texts and Sources get enforcement the moment their bundles are enabled,
  // with no further code change here.
  if ($entity->getEntityTypeId() === 'node'
    && in_array($entity->bundle(), CollectionVisibility::groupNodeBundles(), TRUE)) {
    return _mandala_group_inheritance_node_access($entity, $account);
  }

  return AccessResult::neutral();
}

/**
 * Implements hook_query_TAG_alter() for the node_access tag.
 *
 * The listings half of the same rule hook_entity_access() enforces on entity
 * pages. hook_entity_access() does not govern the SQL Views builds, so without
 * this every published node was listed to anonymous users regardless of its
 * collection's visibility.
 *
 * Core attaches this tag to any query that declares itself access-checked, so
 * one implementation covers Views (via NodeViewsData's 'access query tag', on
 * both the result and the pager count query), EntityQuery with
 * accessCheck(TRUE), and anything built on those.
 */
function mandala_group_inheritance_query_node_access_alter(AlterableInterface $query) {
  if (!$query instanceof SelectInterface) {
    return;
  }
  \Drupal::service('mandala_group_inheritance.node_query_alter')->alter($query);
}

/**
 * Node bundles that have a group_node plugin installed.
 *
 * @deprecated Kept as a thin wrapper for any external caller; new code should
 *   call CollectionVisibility::groupNodeBundles() directly.
 */
function _mandala_group_inheritance_group_node_bundles(): array {
  return CollectionVisibility::groupNodeBundles();
}

/**
 * Restricts a collection's own page to match its visibility.
 *
 * Mirrors the node-side rules so a collection is never more visible than the
 * content inside it. UVA handling was added 2026-09-25: only value 1 was tested
 * before, so 24 of 30 published UVA-only collections were anonymously viewable
 * while their contents were not.
 */
function _mandala_group_inheritance_group_access(GroupInterface $group, AccountInterface $account) {
  $visibility = CollectionVisibility::forGroup($group);

  // Public, or anything unrecognised, is left to Group's own permissions.
  if ($visibility === CollectionVisibility::VISIBILITY_PUBLIC) {
    return AccessResult::neutral()->addCacheableDependency($group);
  }

  // Let superadmins and accounts with a bypass permission through. The global
  // content_editor role (ADR 015) holds 'bypass mandala group access' so it can
  // reach content in private collections without per-group membership.
  if (CollectionVisibility::hasGroupBypass($account)) {
    return AccessResult::neutral()->cachePerPermissions();
  }

  if (CollectionVisibility::allows($visibility, $account, $group)) {
    return AccessResult::neutral()->addCacheableDependency($group);
  }

  // UVA-only: keyed on the authenticated role rather than the individual user,
  // since the decision is identical for every logged-in account.
  if ($visibility === CollectionVisibility::VISIBILITY_UVA) {
    return AccessResult::forbidden('Group is UVA-only; user is not authenticated.')
      ->addCacheableDependency($group)
      ->addCacheContexts(['user.roles:authenticated']);
  }

  return AccessResult::forbidden('Group is private; user is not a member.')
    ->addCacheableDependency($group)
    ->cachePerUser();
}

/**
 * Enforces a node's effective collection visibility.
 *
 * Resolution rules, decided with Than 2026-09-24 against D7's own
 * mb_access.module, which is the only authority on what these values meant:
 *
 *  - The node's own field_group_content_access WINS when it carries a real
 *    value: 1 Public, 2 Private (group members), 3 UVA only.
 *  - Value 0 ("use group defaults"), or no such field at all, resolves from the
 *    owning collection's field_group_access: 0 Public, 1 Private, 2 UVA. This is
 *    ~78% of AV content. D7 reached the node scale by adding 1 to the collection
 *    value; mapping the two scales directly says the same thing without
 *    inheriting the off-by-one.
 *  - UVA means any authenticated user, copying D7 exactly: its grant went to
 *    DRUPAL_AUTHENTICATED_RID and never checked for NetBadge. Anonymous users
 *    never see UVA content.
 *
 * Resolved live rather than denormalised onto each node, because a collection's
 * visibility can be edited and ~9,000 nodes would silently go stale.
 *
 * Deliberately NOT copied from D7: for a "use group defaults" node, D7's public
 * grant took the *collection's* published status instead of the node's, so an
 * unpublished node in a published public collection could be publicly visible.
 * Confirmed with Than as a bug to fix rather than replicate — publication status
 * is core's business, and this function only resolves visibility.
 */
function _mandala_group_inheritance_node_access(EntityInterface $node, AccountInterface $account) {
  // Let superadmins and bypass-capable accounts through immediately. The global
  // content_editor role (ADR 015) holds 'bypass mandala group access'.
  if (CollectionVisibility::hasNodeBypass($account)) {
    return AccessResult::neutral()->cachePerPermissions();
  }

  $group = CollectionVisibility::owningGroup($node);
  if (!$group) {
    // Not in a collection: nothing for this hook to enforce. Note this returns
    // before the node's own field_group_content_access is read, so a
    // collection-less node marked private or UVA is still viewable — 18
    // published video nodes are in exactly that state. Decided 2026-09-28
    // (Than, Yuji): those orphans get migrated into a temporary review group
    // rather than being handled here. See
    // docs/deferred/orphaned-content-temp-group-on-migration.md.
    return AccessResult::neutral()->addCacheableDependency($node);
  }

  $visibility = CollectionVisibility::forNode($node, $group);

  if (CollectionVisibility::allows($visibility, $account, $group)) {
    return AccessResult::neutral()
      ->addCacheableDependency($group)
      ->addCacheableDependency($node);
  }

  // Every outcome below depends on both entities: the node carries its own
  // override and the group carries the value a 0 resolves from, so editing
  // either one has to invalidate this decision.
  if ($visibility === CollectionVisibility::VISIBILITY_UVA) {
    // Keyed on the authenticated role rather than the individual user: the
    // decision is identical for every logged-in account, so cachePerUser()
    // would fragment the cache for no benefit.
    return AccessResult::forbidden('Node is UVA-only; user is not authenticated.')
      ->addCacheableDependency($group)
      ->addCacheableDependency($node)
      ->addCacheContexts(['user.roles:authenticated']);
  }

  return AccessResult::forbidden('Node is private to its collection; user is not a member.')
    ->addCacheableDependency($group)
    ->addCacheableDependency($node)
    ->cachePerUser();
}

/**
 * Resolves a node's effective visibility to 'public', 'private' or 'uva'.
 *
 * @deprecated Kept as a thin wrapper for any external caller; new code should
 *   call CollectionVisibility::forNode() directly.
 */
function _mandala_group_inheritance_effective_visibility(EntityInterface $node, GroupInterface $group): string {
  return CollectionVisibility::forNode($node, $group);
}

/**
 * The node's owning collection or subcollection, if any.
 *
 * @deprecated Kept as a thin wrapper for any external caller; new code should
 *   call CollectionVisibility::owningGroup() directly.
 */
function _mandala_group_inheritance_owning_group(EntityInterface $node): ?GroupInterface {
  return CollectionVisibility::owningGroup($node);
}

// ---------------------------------------------------------------------------
// Visibility inheritance
// ---------------------------------------------------------------------------

/**
 * Implements hook_group_presave().
 *
 * When a subcollection is created with a parent_collection, copy the parent's
 * field_group_access value as the default visibility.
 *
 * A migration save (isSyncing()) is different: the source already carries the
 * subcollection's own D7 value, and overwriting it with the parent's silently
 * loosened 15 AV subcollections (private/UVA-only under a public parent
 * became public/UVA-only). So a migration keeps its own value, and where that
 * differs from the parent's it is recorded as an override
 * (field_visibility_overridden, ADR 011) so a later change to the parent's
 * visibility does not propagate over it.
 */
function mandala_group_inheritance_group_presave(GroupInterface $group) {
  if ($group->bundle() !== 'subcollection' || !$group->isNew()) {
    return;
  }

  $parent_ref = $group->get('field_parent_collection');
  if ($parent_ref->isEmpty()) {
    return;
  }

  /** @var \Drupal\group\Entity\GroupInterface $parent */
  $parent = $parent_ref->entity;
  if (!$parent) {
    return;
  }

  if ($group->isSyncing()) {
    if (!$group->get('field_group_access')->isEmpty()
      && (int) $group->get('field_group_access')->value !== (int) $parent->get('field_group_access')->value) {
      $group->set('field_visibility_overridden', TRUE);
    }
    return;
  }

  $group->set('field_group_access', $parent->get('field_group_access')->value);
}

/**
 * Implements hook_group_update().
 *
 * When a collection's field_group_access changes, propagate to subcollections
 * that have not independently overridden their visibility.
 */
function mandala_group_inheritance_group_update(GroupInterface $group) {
  if ($group->bundle() !== 'collection') {
    return;
  }

  $old = (int) $group->original->get('field_group_access')->value;
  $new = (int) $group->get('field_group_access')->value;
  if ($old === $new) {
    return;
  }

  _mandala_group_inheritance_propagate_visibility($group, $new);
}

/**
 * Propagates a visibility value from a collection to its non-overridden subcollections.
 */
function _mandala_group_inheritance_propagate_visibility(GroupInterface $collection, int $new_access) {
  $subcollections = \Drupal::entityTypeManager()
    ->getStorage('group')
    ->loadByProperties([
      'type' => 'subcollection',
      'field_parent_collection' => $collection->id(),
    ]);

  foreach ($subcollections as $sub) {
    if ($sub->get('field_visibility_overridden')->value) {
      continue;
    }
    $sub->set('field_group_access', $new_access);
    $sub->save();
  }
}

// ---------------------------------------------------------------------------
// Membership inheritance
// ---------------------------------------------------------------------------

/**
 * Implements hook_group_relationship_insert().
 *
 * Handles two cases:
 *   A. Subcollection created with a parent → backfill parent's existing members.
 *   B. User added to a collection → cascade-add to all its subcollections.
 */
function mandala_group_inheritance_group_relationship_insert(GroupRelationshipInterface $relationship) {
  $group = $relationship->getGroup();
  $plugin_id = $relationship->getRelationshipType()->getPluginId();

  // Case A: subcollection's parent_collection entity reference was saved.
  // Group relationships don't cover field changes, so backfill is triggered
  // in hook_group_presave (already done for new subcollections by field save).
  // Here we handle the membership cascade from the GROUP MEMBERSHIP plugin.

  // Case B: a user membership in a collection → cascade to subcollections.
  if ($plugin_id === 'group_membership' && $group->bundle() === 'collection') {
    $uid = $relationship->getEntity()->id();
    _mandala_group_inheritance_cascade_member_add($group, $uid);
    return;
  }
}

/**
 * Implements hook_group_relationship_delete().
 *
 * When a member is removed from a collection, remove them from subcollections
 * unless they were added to the subcollection directly (sub-only retention).
 */
function mandala_group_inheritance_group_relationship_delete(GroupRelationshipInterface $relationship) {
  $group = $relationship->getGroup();
  $plugin_id = $relationship->getRelationshipType()->getPluginId();

  if ($plugin_id !== 'group_membership' || $group->bundle() !== 'collection') {
    return;
  }

  $account = $relationship->getEntity();
  _mandala_group_inheritance_cascade_member_remove($group, $account);
}

/**
 * Adds a user to all subcollections of a collection (cascade on collection add).
 */
function _mandala_group_inheritance_cascade_member_add(GroupInterface $collection, int $uid) {
  $subcollections = \Drupal::entityTypeManager()
    ->getStorage('group')
    ->loadByProperties([
      'type' => 'subcollection',
      'field_parent_collection' => $collection->id(),
    ]);

  $account = \Drupal::entityTypeManager()->getStorage('user')->load($uid);
  if (!$account) {
    return;
  }

  foreach ($subcollections as $sub) {
    if (!$sub->getMember($account)) {
      $sub->addMember($account, ['mandala_inherited' => TRUE]);
    }
  }
}

/**
 * Removes a user from subcollections of a collection, preserving sub-only members.
 *
 * A user is a "sub-only member" if they were added directly to the subcollection
 * rather than via cascade from the parent. We track this via the boolean
 * mandala_inherited flag on the group membership relationship.
 */
function _mandala_group_inheritance_cascade_member_remove(GroupInterface $collection, $account) {
  $subcollections = \Drupal::entityTypeManager()
    ->getStorage('group')
    ->loadByProperties([
      'type' => 'subcollection',
      'field_parent_collection' => $collection->id(),
    ]);

  foreach ($subcollections as $sub) {
    $membership = $sub->getMember($account);
    if (!$membership) {
      continue;
    }

    // Retain if the member was added directly (not via cascade). Migrated
    // memberships have no flag set, which is correct — every D7 og_membership
    // was an explicit (direct) membership.
    $relationship = $membership->getGroupRelationship();
    if (!$relationship->get('mandala_inherited')->value) {
      // Direct subcollection member — retain.
      continue;
    }

    $relationship->delete();
  }
}

// ---------------------------------------------------------------------------
// Subcollection creation: backfill members from parent
// ---------------------------------------------------------------------------

/**
 * Implements hook_group_insert().
 *
 * When a new subcollection is created with a parent, backfill the parent's
 * existing members into the subcollection (so new subcollections start with
 * inherited membership, not just future additions).
 */
function mandala_group_inheritance_group_insert(GroupInterface $group) {
  if ($group->bundle() !== 'subcollection') {
    return;
  }

  $parent_ref = $group->get('field_parent_collection');
  if ($parent_ref->isEmpty()) {
    return;
  }

  /** @var \Drupal\group\Entity\GroupInterface $parent */
  $parent = $parent_ref->entity;
  if (!$parent) {
    return;
  }

  foreach ($parent->getMembers() as $member) {
    $account = $member->getUser();
    if ($account && !$group->getMember($account)) {
      $group->addMember($account, ['mandala_inherited' => TRUE]);
    }
  }
}
