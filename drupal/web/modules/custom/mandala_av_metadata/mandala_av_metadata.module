<?php

/**
 * @file
 * AV15: technical-metadata presentation for audio/video nodes.
 *
 * Rebuilt 2026-09-17 to match the *real* live shape, not Images' Sprint 2
 * B2 modal (the sprint doc's original precedent) -- the live AV site
 * (av.mandala.library.virginia.edu, real D7 theme, not the React SPA) uses
 * a Field Group "Details" accordion with named panels (Details, People,
 * Rights & Licensing, Availability & Access, Technical Metadata), plus a
 * "Video Overview" block (creator + description) above the fold. The exact
 * field-to-panel mapping was pulled from the live DOM, not our local
 * `d7_av` dump's `field_group` table -- that table only has edit-form
 * groups, confirming the dump predates this accordion. Demo-priority build
 * (shape + a glimpse of real data), not pixel-for-pixel fidelity: no
 * "Related Audio-Video" tab, no jQuery UI accordion behavior (plain
 * Bootstrap 5 accordion instead), "Availability & Access" left as an empty
 * placeholder since its real field mapping couldn't be confirmed (empty on
 * the live example checked) and may belong to AV7 (Group access) rather
 * than AV15.
 *
 * Implemented as an extra field (pseudo-field) rather than a full node
 * template override -- AV9 already owns the rest of the default view
 * mode's layout via display config.
 */

declare(strict_types=1);

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Render\Markup;
use Drupal\node\NodeInterface;
use Drupal\paragraphs\ParagraphInterface;

/**
 * Accordion panel definitions, panel key => [label, node field names].
 *
 * Field-to-panel mapping confirmed against the live DOM at
 * av.mandala.library.virginia.edu (checked 2026-09-17), not guessed.
 * field_pbcore_title/description are deliberately absent -- production
 * shows those above the fold (see MANDALA_AV_METADATA_OVERVIEW_FIELDS),
 * not in the accordion. field_transcript is absent -- production feeds it
 * to the transcript panel, not a raw file link (stubbed here, Sprint 4/
 * Spike 11 territory). field_workflow is handled separately below since
 * it's access-gated, not part of any of these panels on the live site.
 */
const MANDALA_AV_METADATA_PANELS = [
  'details' => ['label' => 'Details', 'fields' => ['field_pbcore_coverage', 'field_pbcore_relation']],
  'people' => ['label' => 'People', 'fields' => ['field_pbcore_creator', 'field_pbcore_contributor', 'field_pbcore_publisher', 'field_pbcore_sponsor']],
  'rights' => ['label' => 'Rights & Licensing', 'fields' => ['field_pbcore_rights_summary', 'field_copyright_owner', 'field_year_published']],
  'availability' => ['label' => 'Availability & Access', 'fields' => []],
  'technical' => ['label' => 'Technical Metadata', 'fields' => ['field_pbcore_identifier', 'field_pbcore_extension', 'field_pbcore_instantiation']],
];

/**
 * "People" panel fields: paired role+name rather than the generic
 * one-row-per-subfield rendering -- production uses the role value itself
 * as the row label ("Cinematographer", "Executive Producer"), name as the
 * value. Each of these paragraph types has exactly one role field
 * (name containing 'role', or 'rome' for field_publisher_rome's D7 typo)
 * and one name field.
 */
const MANDALA_AV_METADATA_PEOPLE_FIELDS = ['field_pbcore_creator', 'field_pbcore_contributor', 'field_pbcore_publisher', 'field_pbcore_sponsor'];

/**
 * Implements hook_entity_extra_field_info().
 */
function mandala_av_metadata_entity_extra_field_info(): array {
  $extra = [];
  foreach (['audio', 'video'] as $bundle) {
    $extra['node'][$bundle]['display']['av_technical_metadata'] = [
      'label' => t('Technical metadata (AV15)'),
      'description' => t('Video Overview block + Details/People/Rights/Technical accordion.'),
      'weight' => 90,
      'visible' => FALSE,
    ];
  }
  return $extra;
}

/**
 * Implements hook_theme().
 */
function mandala_av_metadata_theme($existing, $type, $theme, $path): array {
  return [
    'mandala_av_technical_modal' => [
      'variables' => [
        'node' => NULL,
        'overview' => NULL,
        'panels' => [],
        'workflow' => NULL,
      ],
    ],
  ];
}

/**
 * Implements hook_ENTITY_TYPE_view() for node.
 */
function mandala_av_metadata_node_view(array &$build, EntityInterface $node, EntityViewDisplayInterface $display, $view_mode): void {
  if (!$node instanceof NodeInterface || !in_array($node->bundle(), ['audio', 'video'], TRUE)) {
    return;
  }
  if (!$display->getComponent('av_technical_metadata')) {
    return;
  }

  $overview = _mandala_av_metadata_build_overview($node);
  $panels = _mandala_av_metadata_build_panels($node);
  $workflow = _mandala_av_metadata_build_workflow($node);

  if (!$overview && !$panels && !$workflow) {
    return;
  }

  $build['av_technical_metadata'] = [
    '#theme' => 'mandala_av_technical_modal',
    '#node' => $node,
    '#overview' => $overview,
    '#panels' => $panels,
    '#workflow' => $workflow,
    '#attached' => ['library' => ['mandala_av_metadata/technical_modal']],
  ];
}

/**
 * Builds the "Video Overview" block: creator names + description.
 *
 * A glimpse of production's above-the-fold summary, not a full port --
 * production also shows date/duration/a collection link there, sourced
 * from fields AV9/AV16 already surface elsewhere on this page.
 */
function _mandala_av_metadata_build_overview(NodeInterface $node): ?array {
  $creators = [];
  if (!$node->get('field_pbcore_creator')->isEmpty()) {
    foreach ($node->get('field_pbcore_creator') as $item) {
      if ($item->entity instanceof ParagraphInterface && !$item->entity->get('field_creator')->isEmpty()) {
        $creators[] = $item->entity->get('field_creator')->value;
      }
    }
  }

  $description = NULL;
  if (!$node->get('field_pbcore_description')->isEmpty()) {
    $first = $node->get('field_pbcore_description')->first()->entity;
    if ($first instanceof ParagraphInterface && !$first->get('field_description')->isEmpty()) {
      $description = strip_tags($first->get('field_description')->value);
    }
  }

  if (!$creators && !$description) {
    return NULL;
  }
  return ['creators' => implode(', ', $creators), 'description' => $description];
}

/**
 * Builds the 5 accordion panels per MANDALA_AV_METADATA_PANELS.
 */
function _mandala_av_metadata_build_panels(NodeInterface $node): array {
  $panels = [];
  foreach (MANDALA_AV_METADATA_PANELS as $key => $panel) {
    $items = [];
    foreach ($panel['fields'] as $field_name) {
      if (!$node->hasField($field_name) || $node->get($field_name)->isEmpty()) {
        continue;
      }
      $definition = $node->getFieldDefinition($field_name);
      $type = $definition->getType();

      if ($type === 'string') {
        // field_copyright_owner / field_year_published -- plain node fields.
        $items[] = ['label' => (string) $definition->getLabel(), 'value' => $node->get($field_name)->value];
        continue;
      }
      if ($type === 'text_long') {
        // field_pbcore_rights_summary.
        $item = $node->get($field_name)->first();
        $items[] = ['label' => (string) $definition->getLabel(), 'markup' => Markup::create(check_markup($item->value, $item->format ?: 'basic_html'))];
        continue;
      }

      // entity_reference_revisions -- walk each paragraph.
      foreach ($node->get($field_name) as $delta) {
        if (!$delta->entity instanceof ParagraphInterface) {
          continue;
        }
        if (in_array($field_name, MANDALA_AV_METADATA_PEOPLE_FIELDS, TRUE)) {
          $person = _mandala_av_metadata_render_person($delta->entity);
          if ($person) {
            $items[] = $person;
          }
        }
        else {
          // Technical Metadata: production flattens instantiation's
          // sub-fields directly into the panel rather than nesting them
          // under an "Instantiation" heading -- matched here for shape.
          array_push($items, ..._mandala_av_metadata_render_paragraph($delta->entity));
        }
      }
    }
    $panels[$key] = ['label' => $panel['label'], 'items' => $items];
  }
  return $panels;
}

/**
 * Builds the (access-gated) workflow section.
 *
 * D7 restricts field_workflow via field_permissions (CUSTOM type):
 * confirmed against the real production role_permission table that
 * anonymous/general-authenticated users have no "view field_workflow"
 * grant at all -- only site admin / content admin / workflow editor roles
 * do (matches: it doesn't appear anywhere on the live page loaded
 * anonymously either). D11 has no equivalent field-level permission wired
 * yet, so this reuses node update access as the stand-in, same reasoning
 * as Images' field_private_note gate.
 */
function _mandala_av_metadata_build_workflow(NodeInterface $node): ?array {
  if (!$node->access('update') || $node->get('field_workflow')->isEmpty()) {
    return NULL;
  }
  $paragraph = $node->get('field_workflow')->entity;
  if (!$paragraph instanceof ParagraphInterface) {
    return NULL;
  }
  return ['label' => (string) $node->getFieldDefinition('field_workflow')->getLabel(), 'items' => _mandala_av_metadata_render_paragraph($paragraph)];
}

/**
 * Pairs a "People" paragraph's role field (the label) with its name field
 * (the value) -- each of these 4 paragraph types has exactly one of each.
 */
function _mandala_av_metadata_render_person(ParagraphInterface $paragraph): ?array {
  $role = NULL;
  $name = NULL;
  $nameLabel = NULL;
  foreach ($paragraph->getFieldDefinitions() as $field_name => $definition) {
    if ($definition->getFieldStorageDefinition()->isBaseField() || $paragraph->get($field_name)->isEmpty()) {
      continue;
    }
    if (str_contains($field_name, 'role') || str_contains($field_name, 'rome')) {
      $role = $paragraph->get($field_name)->value;
    }
    else {
      $name = $paragraph->get($field_name)->value;
      $nameLabel = (string) $definition->getLabel();
    }
  }
  return $name === NULL ? NULL : ['label' => $role ?: $nameLabel, 'value' => $name];
}

/**
 * Renders a single paragraph's own fields as a flat label/value list.
 *
 * Introspects field definitions rather than hand-listing them -- AV3's
 * relevant paragraph types carry dozens of sub-fields between them, and
 * av_pbcore_instantiation nests a second paragraph type
 * (av_pbcore_format_id), handled here by recursion.
 *
 * @return array
 *   A list of ['label' => string, 'value'|'markup' => mixed] items, plus
 *   ['label' => string, 'nested' => array] for a nested paragraph
 *   reference field.
 */
function _mandala_av_metadata_render_paragraph(ParagraphInterface $paragraph): array {
  $items = [];
  foreach ($paragraph->getFieldDefinitions() as $field_name => $definition) {
    if ($definition->getFieldStorageDefinition()->isBaseField()) {
      continue;
    }
    if ($paragraph->get($field_name)->isEmpty()) {
      continue;
    }

    $label = (string) $definition->getLabel();
    $type = $definition->getType();

    if ($type === 'entity_reference_revisions') {
      $nested = [];
      foreach ($paragraph->get($field_name) as $item) {
        if ($item->entity instanceof ParagraphInterface) {
          $nested[] = ['items' => _mandala_av_metadata_render_paragraph($item->entity)];
        }
      }
      if ($nested) {
        $items[] = ['label' => $label, 'nested' => $nested];
      }
      continue;
    }

    if ($type === 'entity_reference') {
      // field_relation_identifier only (a plain entity reference, unlike
      // every other paragraph-to-paragraph link here) -- ->value doesn't
      // exist on this item type, so it needs its own branch rather than
      // silently falling through to the default case below.
      $values = [];
      foreach ($paragraph->get($field_name) as $item) {
        if ($item->entity) {
          $values[] = $item->entity->label();
        }
      }
      if ($values) {
        $items[] = ['label' => $label, 'value' => implode('; ', $values)];
      }
      continue;
    }

    $values = [];
    foreach ($paragraph->get($field_name) as $item) {
      $values[] = match ($type) {
        'datetime' => \Drupal::service('date.formatter')->format(strtotime($item->value), 'custom', 'j M Y'),
        'text_long' => strip_tags($item->value),
        default => (string) $item->value,
      };
    }
    $items[] = ['label' => $label, 'value' => implode('; ', array_filter($values, 'strlen'))];
  }
  return $items;
}
