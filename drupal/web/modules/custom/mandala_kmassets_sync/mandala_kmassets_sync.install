<?php

/**
 * @file
 * Install and update hooks for mandala_kmassets_sync.
 */

/**
 * Formerly created the interim node-to-trid table; superseded by update 10002.
 *
 * Left as a no-op so installs that never ran it do not create a table that
 * update 10002 would immediately drop.
 */
function mandala_kmassets_sync_update_10001(): void {
}

/**
 * Drop the interim node-to-trid table (T2 phase 7).
 *
 * `trid_i` now comes from the av_transcript entity. The table was only ever a
 * copy of D7's tracking rows, so nothing is lost; D7 still holds the source.
 */
function mandala_kmassets_sync_update_10002(): void {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('mandala_kmassets_trid_map')) {
    $schema->dropTable('mandala_kmassets_trid_map');
  }
}
