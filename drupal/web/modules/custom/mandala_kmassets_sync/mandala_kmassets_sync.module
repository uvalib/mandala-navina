<?php

declare(strict_types=1);

use Drupal\node\NodeInterface;

/**
 * Implements hook_node_insert().
 */
function mandala_kmassets_sync_node_insert(NodeInterface $node): void {
  if (!$node->isPublished() || !_mandala_kmassets_sync_is_configured() || _mandala_kmassets_sync_is_suppressed()) {
    return;
  }
  _mandala_kmassets_sync_index($node);
}

/**
 * Implements hook_node_update().
 */
function mandala_kmassets_sync_node_update(NodeInterface $node): void {
  if (!_mandala_kmassets_sync_is_configured() || _mandala_kmassets_sync_is_suppressed()) {
    return;
  }
  $sink = \Drupal::service('mandala_kmassets_sync.direct_sink');
  try {
    if ($node->isPublished()) {
      $sink->indexNode($node);
    }
    else {
      // Node was unpublished — remove from index.
      $sink->deleteNode($node);
    }
  }
  catch (\Throwable $e) {
    \Drupal::logger('mandala_kmassets_sync')->error(
      'Failed to sync kmassets doc for node @nid on update: @message',
      ['@nid' => $node->id(), '@message' => $e->getMessage()],
    );
  }
}

/**
 * Implements hook_node_delete().
 */
function mandala_kmassets_sync_node_delete(NodeInterface $node): void {
  if (!_mandala_kmassets_sync_is_configured() || _mandala_kmassets_sync_is_suppressed()) {
    return;
  }
  try {
    \Drupal::service('mandala_kmassets_sync.direct_sink')->deleteNode($node);
  }
  catch (\Throwable $e) {
    \Drupal::logger('mandala_kmassets_sync')->error(
      'Failed to delete kmassets doc for node @nid: @message',
      ['@nid' => $node->id(), '@message' => $e->getMessage()],
    );
  }
}

/**
 * Indexes a published node to the kmassets Solr master, logging any failure.
 */
function _mandala_kmassets_sync_index(NodeInterface $node): void {
  try {
    \Drupal::service('mandala_kmassets_sync.direct_sink')->indexNode($node);
  }
  catch (\Throwable $e) {
    \Drupal::logger('mandala_kmassets_sync')->error(
      'Failed to index kmassets doc for node @nid: @message',
      ['@nid' => $node->id(), '@message' => $e->getMessage()],
    );
  }
}

/**
 * Returns TRUE if the kmassets Solr master URL is configured.
 *
 * All node hooks skip silently when FALSE — avoids one error log entry per
 * node in environments (DDEV, CI) where Solr is intentionally not wired up.
 */
function _mandala_kmassets_sync_is_configured(): bool {
  return !empty(\Drupal::config('mandala_kmassets_sync.settings')->get('solr_master_url'));
}

/**
 * Returns TRUE while a migration import/rollback is running in this process.
 *
 * The node hooks skip the inline Solr write when TRUE — a full migration writes
 * ~111k docs the bulk index (kmassets:index-all) is going to write anyway, and
 * on staging/dev those inline writes hit the real kmassets master. Toggled by
 * \Drupal\mandala_kmassets_sync\EventSubscriber\MigrateSyncSubscriber on the
 * migrate PRE/POST import and rollback events.
 */
function _mandala_kmassets_sync_is_suppressed(): bool {
  return \Drupal::service('mandala_kmassets_sync.migrate_suppressor')->isSuppressed();
}
