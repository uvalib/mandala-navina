{#
/**
 * @file
 * Theme override for the Page Title block, ported from the D7
 * shanti_sarvaka page.tpl.php's h1.page-title markup.
 *
 * Available variables:
 * - title_attributes: HTML attributes for the page title element.
 * - title_prefix / title_suffix: additional module-supplied output.
 * - title: The page title.
 *
 * icon_class (banner icon hook) is not wired yet -- deferred to the
 * Mandala-brand preprocess pass along with banner_class/shanti_site.
 */
#}
{{ title_prefix }}
{% if title|render|striptags|trim %}
  <h1 class="page-title"{{ title_attributes }}>
    {% if icon_class|default(false) %}<span class="icon shanti-icon-{{ icon_class }}"></span>{% endif %}
    <span class="page-title-text">{{ title }}</span>
  </h1>
{% endif %}
{{ title_suffix }}
