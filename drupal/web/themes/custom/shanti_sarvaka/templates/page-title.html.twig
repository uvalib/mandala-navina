{#
/**
 * @file
 * Theme override for the Page Title block, ported from the D7
 * shanti_sarvaka page.tpl.php's h1.page-title markup.
 *
 * Available variables:
 * - title_attributes: HTML attributes for the page title element.
 * - title_prefix / title_suffix: additional module-supplied output.
 * - title: The page title.
 *
 * Confirmed against real production (Images, including 404 pages, not
 * just the front page): every Images page title is prefixed "Explore" and
 * uses a shanticon-photos icon. Confirmed AV differs on both counts --
 * checked two live AV pages, neither has the "Explore" prefix, and the
 * icon is shanticon-audio-video. shanti_sarvaka_preprocess_page_title()
 * (see _shanti_sarvaka_current_asset_site()) supplies shanti_site_icon/
 * shanti_site_prefix per the current node's bundle, defaulting to Images'
 * originals for every bundle that isn't audio/video.
 */
#}
{{ title_prefix }}
{% if title|render|striptags|trim %}
  <h1 class="page-title"{{ title_attributes }}>
    <span class="icon {{ shanti_site_icon|default('shanticon-photos') }}"></span>
    <span class="page-title-text">{% if shanti_site_prefix|default(true) %}<span class="pt-prefix">{{ 'Explore'|t }}</span> {% endif %}{{ title }}</span>
  </h1>
{% endif %}
{{ title_suffix }}
