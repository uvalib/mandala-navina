<?php

// Read configuration with getenv(), NOT $_ENV.
//
// The image ships php.ini-production, which sets variables_order = "GPCS" — no
// "E" — so $_ENV is never populated: it is empty (count 0) even when the
// variables are present in the container environment. getenv() reads the real
// environment and is unaffected.
//
// This was not theoretical. Every value below silently became empty:
//   * $SOLR_BASE collapsed to "/solr", making every Solr URL host-relative, so
//     file_get_contents() tried the local filesystem. All searches failed AND
//     /solr/kmassets/status returned HTTP 400 — the exact path the ALB
//     health-checks, so the target would never have come up healthy.
//   * $REDIS_HOST fell back to 127.0.0.1 (nothing listens there inside the
//     container), so the ADR 014 token read always failed and every logged-in
//     user was silently downgraded to the anonymous filter — serving only
//     public results, with no error anywhere.
//
// It went unnoticed because the D7 deployment never used this file as written:
// the copy on the box hardcodes literal values and comments the env check out.
// check.php uses getenv() correctly, which made startup validation pass and
// masked the problem.
//
// NB: `?:` below, not `??`. getenv() returns FALSE (not NULL) for an unset
// variable, so `??` would assign FALSE rather than the intended default.

if ( getenv("SOLR_BASEURL") === false ) {
    throw new Exception("Environment variable SOLR_BASEURL must be set!");
}
$DEFAULT_RETURL = getenv("DEFAULT_RETURL"); // "https://standalone.kmaps.virginia.edu/home";
$SOLR_BASE = getenv("SOLR_BASEURL")."/solr";

$SOLR_URLS = array(
             "/solr/kmassets" => "$SOLR_BASE/kmassets",
             "/solr/kmterms" => "$SOLR_BASE/kmterms",
             "/solr/mandala-av-transcripts" => "$SOLR_BASE/mandala-av-transcripts",
);

// Cores that carry no visibility fields of their own and inherit access from the kmassets
// document of the parent node (Spike 11, access option C). The value is the Solr join
// local-params body; Searcher wraps the per-user visibility fq in it, so a unit is admitted
// only if its kmassets document (matched on trid_i = is_trid) passes the same fq.
// A unit with no kmassets document matches nothing: it fails closed.
$JOIN_ACCESS = array(
             "/solr/mandala-av-transcripts" => "from=trid_i to=is_trid fromIndex=kmassets",
);
$STATUS_URLS = array(
	     "/solr/kmassets" => "$SOLR_BASE/admin/cores?action=STATUS&core=kmassets&indexInfo=false",
	     "/solr/kmterms" => "$SOLR_BASE/admin/cores?action=STATUS&core=kmterms&indexInfo=false",
	     "/solr/mandala-av-transcripts" => "$SOLR_BASE/admin/cores?action=STATUS&core=mandala-av-transcripts&indexInfo=false",
	     "/solr/all" => "$SOLR_BASE/admin/cores?action=STATUS&indexInfo=false",
);

// Shared Redis instance (ADR 014): Drupal writes `mandala_solr_fq:{uid}`
// visibility tokens here; the proxy only ever reads them. Same instance
// Drupal's settings.php points at for this environment.
$REDIS_HOST = getenv("REDIS_HOST") ?: "127.0.0.1";
$REDIS_PORT = getenv("REDIS_PORT") ?: "6379";
