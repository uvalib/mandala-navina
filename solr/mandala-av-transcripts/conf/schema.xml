<?xml version="1.0" encoding="UTF-8" ?>
<!--
  mandala-av-transcripts: one Solr document per time-coded unit (TCU) of an AV transcript.
  See docs/spikes/spike-11-av-transcript-replication.md (question 6) for the decisions behind
  this file.

  Legacy compatibility. The React client (mandala-om/kmaps-app, src/legacy/audiovideo.js) reads
  documents from D7's `mandala-av` core by `is_trid:<transcript id>` sorted by `fts_start`, and
  uses only these fields: fts_start, fts_end, fts_duration, ss_speaker_bod, ss_language, and the
  language tier fields (content_bod, dzo_bod, ts_content_*). Those names and value shapes are kept
  exactly. D7's Drupal ApacheSolr fields (site, hash, bundle, path, url, content, teaser, spell,
  ...) are NOT carried over; nothing reads them.

  Not in this file: access control. Units carry only the transcript id (is_trid); visibility is
  enforced by a cross-core join to kmassets in solr-proxy (decided in the spike).

  Needs the Solr analysis-extras contrib (ICU) loaded by solrconfig.xml. Written for Solr 7.x
  and uses Point field types, which also work on 9.x (Trie types were removed in 9).
-->
<schema name="mandala-av-transcripts" version="1.6">

  <!-- ===== Field types ===== -->
  <fieldType name="string" class="solr.StrField" sortMissingLast="true" docValues="true"/>
  <fieldType name="long"   class="solr.LongPointField"  docValues="true"/>
  <!-- float, not double: D7 stored single-precision floats, and a float keeps the JSON output
       identical (10.033, not 10.032999...) for the client. -->
  <fieldType name="float"  class="solr.FloatPointField" docValues="true"/>

  <!-- Tibetan-script tiers (content_bod, dzo_bod, speaker_bod). Identical to the legacy
       text_bod: ICU tokenizer, no filters. -->
  <fieldType name="text_bod" class="solr.TextField">
    <analyzer>
      <tokenizer class="solr.ICUTokenizerFactory"/>
    </analyzer>
  </fieldType>

  <!-- Non-English, non-Tibetan language tiers (ts_content_wylie, ts_content_und, Chinese,
       Nepali, and the other smaller-volume tiers). ICU tokenizer plus ICU folding (case and
       accent folding, no stemming, no stop words) — confirmed better than D7's whitespace
       tokenizer for languages not written with spaces between words (Chinese) and for Wylie,
       which D7's English analyzer never handled correctly. Than confirmed 2026-10-06: these
       tiers are actively searched, so correct tokenization matters here, but no stemmer exists
       for Wylie (a Tibetan romanization scheme, not a language Solr has stemming support for),
       so this is the right default for it, not a placeholder the way it was for English. See
       docs/deferred/transcript-tier-analyzers-and-language-fields.md — per-language fields
       (rather than one analyzer per naming pattern) remain deferred; synonyms status is also
       still unconfirmed. -->
  <fieldType name="text_tier" class="solr.TextField" positionIncrementGap="100">
    <analyzer>
      <tokenizer class="solr.ICUTokenizerFactory"/>
      <filter class="solr.ICUFoldingFilterFactory"/>
    </analyzer>
  </fieldType>

  <!-- English tier (ts_content_eng) only. DECIDED 2026-10-06 (Than): users rely on English
       stemming ("chant" must match "chanting"), so the ICU default above — which dropped it —
       was a real regression for the single largest tier by volume (71,873 of ~145k non-Tibetan
       tier values). Standard Solr English analysis, matching the "text_en" shape every other
       Solr/Lucene default schema ships (e.g. Drupal's own search_api_solr text_en field type):
       StandardTokenizer, English possessive stripping, stopwords (Solr's bundled
       lang/stopwords_en.txt, no local file needed), lowercasing, Porter stemming. No synonyms —
       whether D7's synonyms file is even populated is still unconfirmed (see the deferred note);
       add a SynonymGraphFilterFactory here if/when that's answered. -->
  <fieldType name="text_tier_en" class="solr.TextField" positionIncrementGap="100">
    <analyzer>
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.StopFilterFactory" ignoreCase="true" words="lang/stopwords_en.txt"/>
      <filter class="solr.LowerCaseFilterFactory"/>
      <filter class="solr.EnglishPossessiveFilterFactory"/>
      <filter class="solr.PorterStemFilterFactory"/>
    </analyzer>
  </fieldType>

  <!-- ===== Fields ===== -->
  <field name="id" type="string" indexed="true" stored="true" required="true"/>
  <field name="_version_" type="long" indexed="false" stored="false"/>

  <!-- tcu-11-{unit id}. entity_id is the unit id (D7's tcuid, preserved); it builds the
       #tcu/{id} deep link, as in D7. -->
  <field name="entity_id" type="long" indexed="true" stored="true"/>
  <!-- Parent AV node (D11 nid). Ours, not in D7 documents. -->
  <field name="nid" type="long" indexed="true" stored="true"/>
  <!-- Transcript id (D7's trid, preserved). The client's one query key. -->
  <field name="is_trid" type="long" indexed="true" stored="true"/>

  <field name="fts_start"    type="float" indexed="true" stored="true"/>
  <field name="fts_end"      type="float" indexed="true" stored="true"/>
  <field name="fts_duration" type="float" indexed="true" stored="true"/>

  <!-- ss_speaker_bod would match both ss_* and *_bod; the longer pattern (*_bod) would win and
       index it as Tibetan text. Define it explicitly as the string the client expects. -->
  <field name="ss_speaker_bod" type="string" indexed="true" stored="true"/>
  <field name="ss_language"    type="string" indexed="true" stored="true"/>

  <!-- English tier: explicit field, not the ts_* dynamic pattern below — an explicit field
       always wins over a dynamicField match in Solr, regardless of declaration order. See
       text_tier_en above for why. -->
  <field name="ts_content_eng" type="text_tier_en" indexed="true" stored="true" multiValued="false"/>

  <!-- ===== Dynamic fields (legacy names) ===== -->
  <!-- Remaining language tiers: 16 names in the D7 data (ts_content_* other than English, plus
       content_bod and dzo_bod below). -->
  <dynamicField name="ts_*"   type="text_tier" indexed="true" stored="true" multiValued="false"/>
  <dynamicField name="*_bod"  type="text_bod"  indexed="true" stored="true" multiValued="false"/>
  <!-- Speaker tiers: ss_speaker, ss_speaker_{lang} (14 names in the D7 data). -->
  <dynamicField name="ss_*"   type="string"    indexed="true" stored="true" multiValued="false"/>
  <!-- Multi-valued strings, e.g. sm_has_tier (the "Transcript Languages" facet). How that facet
       is served from this core is still open in the spike. -->
  <dynamicField name="sm_*"   type="string"    indexed="true" stored="true" multiValued="true"/>

  <uniqueKey>id</uniqueKey>
</schema>
