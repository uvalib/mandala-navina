<?xml version="1.0" encoding="UTF-8" ?>
<!--
  mandala-av-transcripts: one Solr document per time-coded unit (TCU) of an AV transcript.
  See docs/spikes/spike-11-av-transcript-replication.md (question 6) for the decisions behind
  this file.

  Legacy compatibility. The React client (mandala-om/kmaps-app, src/legacy/audiovideo.js) reads
  documents from D7's `mandala-av` core by `is_trid:<transcript id>` sorted by `fts_start`, and
  uses only these fields: fts_start, fts_end, fts_duration, ss_speaker_bod, ss_language, and the
  language tier fields (content_bod, dzo_bod, ts_content_*). Those names and value shapes are kept
  exactly. D7's Drupal ApacheSolr fields (site, hash, bundle, path, url, content, teaser, spell,
  ...) are NOT carried over; nothing reads them.

  Not in this file: access control. Units carry only the transcript id (is_trid); visibility is
  enforced by a cross-core join to kmassets in solr-proxy (decided in the spike).

  Needs the Solr analysis-extras contrib (ICU) loaded by solrconfig.xml. Written for Solr 7.x
  and uses Point field types, which also work on 9.x (Trie types were removed in 9).
-->
<schema name="mandala-av-transcripts" version="1.6">

  <!-- ===== Field types ===== -->
  <fieldType name="string" class="solr.StrField" sortMissingLast="true" docValues="true"/>
  <fieldType name="long"   class="solr.LongPointField"  docValues="true"/>
  <fieldType name="int"    class="solr.IntPointField"   docValues="true"/>
  <!-- float, not double: D7 stored single-precision floats, and a float keeps the JSON output
       identical (10.033, not 10.032999...) for the client. -->
  <fieldType name="float"  class="solr.FloatPointField" docValues="true"/>

  <!-- Tibetan-script tiers (content_bod, speaker_bod). Identical to the legacy text_bod: ICU
       tokenizer, no filters. dzo_bod (Dzongkha) is NOT included here as of 2026-10-06 — it
       gets its own text_dzo fieldType below (same mechanism, separated for independent future
       tuning; see that fieldType's comment). -->
  <fieldType name="text_bod" class="solr.TextField">
    <analyzer>
      <tokenizer class="solr.ICUTokenizerFactory"/>
    </analyzer>
  </fieldType>

  <!-- Remaining smaller-volume language tiers (ts_content_und, ts_content_gyal,
       ts_content_gloss, ts_content_nmm, ts_content_xkf, ts_content_tsum, ts_content_kjz,
       ts_content_npa, ts_content_gvr, ts_content_tsj, ts_content_kte — 11 names, mostly
       Himalayan minority languages with no dedicated Lucene/Solr analyzer). ICU tokenizer plus
       ICU folding (case and accent folding, no stemming, no stop words) — the sensible generic
       default for a language Solr has no specific support for. English, Chinese, Nepali,
       Dzongkha and Wylie have all since been carved out into their own fieldTypes below (see
       each for why); this general-purpose default remains for everything else. DECIDED
       2026-10-06 (Than): these 11 stay on this shared default permanently, not a placeholder —
       none of them have dedicated Lucene/Solr language support, so splitting them into their
       own fieldTypes would just be 11 copies of the same analyzer under different names. See
       docs/deferred/transcript-tier-analyzers-and-language-fields.md; synonyms status for
       English is the one still-open item there. -->
  <fieldType name="text_tier" class="solr.TextField" positionIncrementGap="100">
    <analyzer>
      <tokenizer class="solr.ICUTokenizerFactory"/>
      <filter class="solr.ICUFoldingFilterFactory"/>
    </analyzer>
  </fieldType>

  <!-- English tier (ts_content_eng) only. DECIDED 2026-10-06 (Than): users rely on English
       stemming ("chant" must match "chanting"), so the ICU default above — which dropped it —
       was a real regression for the single largest tier by volume (71,873 of ~145k non-Tibetan
       tier values). Standard Solr English analysis, matching the "text_en" shape every other
       Solr/Lucene default schema ships (e.g. Drupal's own search_api_solr text_en field type):
       StandardTokenizer, English possessive stripping, stopwords (Solr's bundled
       lang/stopwords_en.txt, no local file needed), lowercasing, Porter stemming. No synonyms —
       whether D7's synonyms file is even populated is still unconfirmed (see the deferred note);
       add a SynonymGraphFilterFactory here if/when that's answered. -->
  <fieldType name="text_tier_en" class="solr.TextField" positionIncrementGap="100">
    <analyzer>
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.StopFilterFactory" ignoreCase="true" words="lang/stopwords_en.txt"/>
      <filter class="solr.LowerCaseFilterFactory"/>
      <filter class="solr.EnglishPossessiveFilterFactory"/>
      <filter class="solr.PorterStemFilterFactory"/>
    </analyzer>
  </fieldType>

  <!-- Chinese tier (ts_content_zho) only. DECIDED 2026-10-06 (Than), researched 2026-10-06:
       real sample data from the D7 source confirms Simplified Chinese. Solr's bundled
       analysis-extras contrib (already loaded by this core's two <lib> lines in solrconfig.xml)
       ships lucene-analyzers-smartcn alongside ICU — no extra install needed. The initial
       research draft of this fieldType named solr.SmartChineseSentenceTokenizerFactory plus
       solr.SmartChineseWordTokenFilterFactory, which do not exist in this Lucene/Solr version
       (confirmed by inspecting the actual jar after a ClassNotFoundException loading it into a
       throwaway Solr 7.7.3 core) — lucene-analyzers-smartcn-7.7.3.jar registers exactly one
       factory, solr.HMMChineseTokenizerFactory, which does both sentence and HMM-based word
       segmentation internally as a single tokenizer (no separate word-token filter needed).
       Generally higher precision for Chinese word boundaries than ICU's generic UAX#29
       segmentation or the older CJK-bigram overlap approach (explicitly the weakest of the
       three for both precision and recall). -->
  <fieldType name="text_tier_zho" class="solr.TextField" positionIncrementGap="100">
    <analyzer>
      <tokenizer class="solr.HMMChineseTokenizerFactory"/>
    </analyzer>
  </fieldType>

  <!-- Nepali tier (ts_content_nep) only — the second-largest non-English tier by volume
       (13,625 values, more than Chinese). DECIDED 2026-10-06 (Than), researched 2026-10-06: no
       dedicated Nepali analyzer or stemmer exists anywhere in Lucene/Solr. IndicNormalization and
       HindiNormalization are script-level Devanagari normalization (Unicode variant folding),
       not Hindi-specific morphology — safe to apply to any Devanagari-script language,
       confirmed by Lucene's own docs describing IndicNormalizationFilter as a shared building
       block across multiple Indic-script analyzers. HindiStemFilter, by contrast, applies real
       Hindi morphological stemming rules and is deliberately NOT included here — Hindi and
       Nepali diverge enough in morphology that using it would risk incorrect stemming rather
       than a safe approximation. -->
  <fieldType name="text_tier_nep" class="solr.TextField" positionIncrementGap="100">
    <analyzer>
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.IndicNormalizationFilterFactory"/>
      <filter class="solr.HindiNormalizationFilterFactory"/>
    </analyzer>
  </fieldType>

  <!-- Dzongkha (dzo_bod) only — 35,525 values, the second-largest tier overall after
       content_bod. DECIDED 2026-10-06 (Than), researched 2026-10-06: no Dzongkha-specific
       analyzer exists in Lucene/Solr, same as Tibetan. Real sample data confirms standard
       Tibetan-script Unicode with tsheg (་) syllable separators, the same orthographic
       convention Classical Tibetan uses — so the ICU tokenizer (which correctly segments at
       the tsheg per Unicode UAX#29) is the same defensible choice as text_bod's. Split into its
       own fieldType, not literally sharing the text_bod instance, purely so Dzongkha can be
       tuned independently later without touching the Tibetan field — the filter chain itself
       is intentionally identical today. -->
  <fieldType name="text_dzo" class="solr.TextField">
    <analyzer>
      <tokenizer class="solr.ICUTokenizerFactory"/>
    </analyzer>
  </fieldType>

  <!-- Wylie tier (ts_content_wylie) only — a Tibetan transliteration scheme (EWTS), not a
       natural language; 30,497 values, the third-largest tier overall. DECIDED 2026-10-06
       (Than: "very simple"), researched 2026-10-06 against THL's own published EWTS
       specification (this project's parent institution) and real ts_content_wylie sample rows.
       Three things the simplest-possible approach must still get right:
         1. Case is phonemically meaningful in EWTS — capitals specifically encode
            Sanskrit-derived sounds (retroflexes, long vowels: T/Th/D/D+h/N/Sh). Case-folding
            would conflate distinct phonemes, so there is deliberately no LowerCaseFilter here.
         2. EWTS has no diacritics by design (the spec's own stated rationale: diacritics are
            hard to type, so capitals substitute for them instead) — so there is nothing for an
            accent-folding filter to usefully fold.
         3. EWTS does not use hyphens for word/syllable boundaries. Real sample rows
            (e.g. "cig_yum", "'dra/_mtsho") show underscores marking a literal space inside the
            original Tibetan, and apostrophes represent a real Tibetan letter ('a-chung) that
            must be preserved, not stripped as punctuation. The one adjustment worth making:
            convert underscores to spaces before tokenizing, so underscore-joined words remain
            independently searchable.
       WhitespaceTokenizer, not StandardTokenizer, is deliberate — Standard's punctuation-aware
       splitting is not verified safe against EWTS's apostrophe-as-letter and slash-as-shad
       conventions. Splitting only on literal whitespace is the minimal, defensibly-correct
       choice; refining further (stripping shad `/`, handling `{...}` editorial brackets) is a
       reasonable future step, not needed for a first pass. -->
  <fieldType name="text_tier_wylie" class="solr.TextField" positionIncrementGap="100">
    <analyzer>
      <charFilter class="solr.PatternReplaceCharFilterFactory" pattern="_" replacement=" "/>
      <tokenizer class="solr.WhitespaceTokenizerFactory"/>
    </analyzer>
  </fieldType>

  <!-- ===== Fields ===== -->
  <field name="id" type="string" indexed="true" stored="true" required="true"/>
  <field name="_version_" type="long" indexed="false" stored="false"/>

  <!-- tcu-11-{unit id}. entity_id is the unit id (D7's tcuid, preserved); it builds the
       #tcu/{id} deep link, as in D7. -->
  <field name="entity_id" type="long" indexed="true" stored="true"/>
  <!-- Parent AV node (D11 nid). Ours, not in D7 documents. -->
  <field name="nid" type="long" indexed="true" stored="true"/>
  <!-- Transcript id (D7's trid, preserved). The client's one query key. -->
  <!-- int, not long, on purpose: the access filter joins this field against kmassets'
       trid_i (an int), and Solr 7.7.3 fails the join with "bytesPerDim=8 but this query has
       bytesPerDim=4" if the two point types differ. See prototype/join-check.sh. -->
  <field name="is_trid" type="int" indexed="true" stored="true"/>

  <field name="fts_start"    type="float" indexed="true" stored="true"/>
  <field name="fts_end"      type="float" indexed="true" stored="true"/>
  <field name="fts_duration" type="float" indexed="true" stored="true"/>

  <!-- ss_speaker_bod would match both ss_* and *_bod; the longer pattern (*_bod) would win and
       index it as Tibetan text. Define it explicitly as the string the client expects. -->
  <field name="ss_speaker_bod" type="string" indexed="true" stored="true"/>
  <field name="ss_language"    type="string" indexed="true" stored="true"/>

  <!-- Per-tier explicit fields, each overriding the generic ts_* / *_bod dynamicField patterns
       below — an explicit field always wins over a dynamicField match in Solr, regardless of
       declaration order. See each fieldType above for why these five specifically are split
       out. -->
  <field name="ts_content_eng"   type="text_tier_en"    indexed="true" stored="true" multiValued="false"/>
  <field name="ts_content_zho"   type="text_tier_zho"   indexed="true" stored="true" multiValued="false"/>
  <field name="ts_content_nep"   type="text_tier_nep"   indexed="true" stored="true" multiValued="false"/>
  <field name="ts_content_wylie" type="text_tier_wylie" indexed="true" stored="true" multiValued="false"/>
  <field name="dzo_bod"          type="text_dzo"        indexed="true" stored="true" multiValued="false"/>

  <!-- ===== Dynamic fields (legacy names) ===== -->
  <!-- Remaining language tiers: 11 ts_content_* names plus content_bod. (16 total before
       2026-10-06's four additional explicit-field splits above; now 12.) -->
  <dynamicField name="ts_*"   type="text_tier" indexed="true" stored="true" multiValued="false"/>
  <dynamicField name="*_bod"  type="text_bod"  indexed="true" stored="true" multiValued="false"/>
  <!-- Speaker tiers: ss_speaker, ss_speaker_{lang} (14 names in the D7 data). -->
  <dynamicField name="ss_*"   type="string"    indexed="true" stored="true" multiValued="false"/>
  <!-- Multi-valued strings, e.g. sm_has_tier (the "Transcript Languages" facet). How that facet
       is served from this core is still open in the spike. -->
  <dynamicField name="sm_*"   type="string"    indexed="true" stored="true" multiValued="true"/>

  <uniqueKey>id</uniqueKey>
</schema>
