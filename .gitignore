# Drupal / Composer
/drupal/vendor/
/drupal/web/core/
/drupal/web/libraries/
/drupal/web/modules/contrib/
/drupal/web/themes/contrib/
/drupal/web/profiles/contrib/
/drupal/web/sites/default/files/
# settings.php is committed (drupal-dsf convention): it is env-driven (no secrets)
# and sets config_sync_directory. Only the per-machine local override is ignored.
/drupal/web/sites/*/settings.local.php

# DDEV — let DDEV manage its own gitignore inside .ddev/
.ddev/.gitignore
.ddev/config.*.yaml
.ddev/db_snapshots/

# Database dumps
/drupal/dumps/
*.sql
*.sql.gz

# MkDocs generated site
/mkdocs/site/

# Claude Code auto-memory (lives in ~/.claude/projects/, not the repo)
/memory/

# OS / IDE
.DS_Store
.vscode
.idea
*.ksh
